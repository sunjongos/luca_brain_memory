# [Luca Voice & Message Pipeline 환경 변수]
# 주의: 실제 시스템 적용 시, 이 파일의 이름을 '.env'로 변경하신 뒤 발급받은 실제 정보를 입력하세요.

# ==========================================
# 1. 양방향 AI 전화 API (Vapi.ai)
# ==========================================
# 가입처: https://vapi.ai
VAPI_API_KEY="여기에_VAPI_PRIVATE_API_KEY_입력"
VAPI_PHONE_NUMBER="+82100000000" # 구매한 Twilio/Vapi 발신 번호 (옵션)

# ==========================================
# 2. 카카오톡 알림톡/문자 메시지 API (Solapi)
# ==========================================
# 가입처: https://solapi.com (가상으로 발송 테스트 가능)
SOLAPI_API_KEY="여기에_솔라피_API_KEY_입력"
SOLAPI_API_SECRET="여기에_솔라피_API_SECRET_입력"
SOLAPI_SENDER_NUMBER="0310000000" # 병원 발신용 승인 번호
